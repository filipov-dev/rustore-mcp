---
{
  "access": "Destructive",
  "body": "Json",
  "description": "Отправляет push-уведомление на одно устройство по его push-токену. Уведомление сразу приходит пользователю: проверьте получателя и текст. Сервер подставляет проект и сервисный токен push из профиля. При успехе ответ — пустой объект. Ошибки: PERMISSION_DENIED — неверный сервисный токен, NOT_FOUND — неверный или устаревший push-токен, INVALID_ARGUMENT — неверные параметры, TOO_MANY_REQUESTS — превышен лимит отправки.",
  "docs_url": "https://www.rustore.ru/help/sdk/push-notifications/send-push-notifications",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "additionalProperties": false,
        "description": "JSON request body.",
        "properties": {
          "message": {
            "additionalProperties": false,
            "description": "Push-уведомление на одно устройство. Нужен data или notification (или android.notification). Объём message — не больше 4096 байт, сервер проверяет его до отправки.",
            "properties": {
              "android": {
                "additionalProperties": false,
                "description": "Параметры для Android.",
                "properties": {
                  "notification": {
                    "additionalProperties": false,
                    "description": "Уведомление для Android; поля перекрывают message.notification.",
                    "properties": {
                      "body": {
                        "description": "Текст уведомления.",
                        "type": "string"
                      },
                      "channel_id": {
                        "description": "Идентификатор канала уведомлений.",
                        "type": "string"
                      },
                      "click_action": {
                        "description": "Действие по нажатию: intent action или deep link.",
                        "type": "string"
                      },
                      "click_action_type": {
                        "description": "Тип click_action: 0 — intent action (по умолчанию), 1 — deep link (RuStore 1.39.0 и новее).",
                        "enum": [
                          0,
                          1
                        ],
                        "type": "integer"
                      },
                      "color": {
                        "description": "Цвет значка в формате `#rrggbb`.",
                        "type": "string"
                      },
                      "icon": {
                        "description": "Значок уведомления.",
                        "type": "string"
                      },
