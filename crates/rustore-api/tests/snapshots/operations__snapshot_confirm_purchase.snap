    "additionalProperties": false,
    "properties": {
      "appId": {
        "description": "Идентификатор приложения из RuStore консоли.\n1. Перейдите на вкладку Приложения и выберите нужное приложение.\n2. Скопируйте идентификатор из URL-адреса страницы приложения — это набор цифр между `apps/` и `/versions`. Пример: `1704024`.",
        "type": "integer"
      },
      "purchaseId": {
        "description": "Идентификатор покупки в формате UUID. Можно получить из результата покупки через SDK, из уведомления на сервер или запросом информации о покупке. Пример: `3aa0c7bd-964e-4562-b218-fe365adb4ae3`.",
        "type": "string"
      }
    },
    "required": [
      "appId",
      "purchaseId"
    ],
    "type": "object"
  },
  "method": "PUT",
  "operation_id": "confirm_purchase",
  "params": [
    {
      "description": "Идентификатор приложения из RuStore консоли.\n1. Перейдите на вкладку Приложения и выберите нужное приложение.\n2. Скопируйте идентификатор из URL-адреса страницы приложения — это набор цифр между `apps/` и `/versions`. Пример: `1704024`.",
