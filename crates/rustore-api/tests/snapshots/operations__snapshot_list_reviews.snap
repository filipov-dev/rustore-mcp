    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "`id` конкретного отзыва. Задается при необходимости получить конкретный отзыв. Пример: `743103`.",
        "type": "integer"
      },
      "packageName": {
        "description": "Наименование пакета приложения. Максимальная длина – 50 символов. Пример: `com.myapp.example`.",
        "type": "string"
      },
      "page": {
        "description": "Номер страницы. Начинается с `0`. Пример: `0`.",
        "type": "integer"
      },
      "size": {
        "description": "Количество отзывов на странице. По умолчанию — `20`, максимально — `100`. Пример: `100`.",
        "type": "integer"
      }
    },
